# Dedicated CHINO Supabase project (never reuse another venue's project)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_20_CHARACTER_PROJECT_REF
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_CLI_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Initial accounts created by create-accounts.js
OWNER_EMAIL=owner@your-domain.com
OWNER_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
COURT_OWNER_EMAIL=courtowner@your-domain.com
COURT_OWNER_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
STAFF_EMAIL=staff@your-domain.com
STAFF_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Public application URLs used by emails and notifications
PUBLIC_LOGO_URL=https://your-domain.example/assets/chino-courts.png
APP_ADMIN_URL=https://your-domain.example/admin.html
APP_PUBLIC_URL=https://your-domain.example
EMAIL_ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example

# Cloudflare Pages
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN
CLOUDFLARE_PAGES_PROJECT=chinopickleball
CLOUDFLARE_PAGES_BRANCH=main
PRIMARY_HOSTNAME=your-domain.example

# Optional integrations
# Maileroo Email API (MAILEROO_FROM_ADDRESS must use a verified sending domain)
MAILEROO_API_KEY=YOUR_MAILEROO_SENDING_KEY
MAILEROO_FROM_ADDRESS=bookings@your-domain.example
MAILEROO_FROM_NAME=CHINO Pickleball Courts
MAILEROO_REPLY_TO=bookings@your-domain.example
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
GOOGLE_VISION_API_KEY=YOUR_GOOGLE_VISION_API_KEY
PAYMENT_PROVIDER=disabled
PAYMONGO_SECRET_KEY=YOUR_PAYMONGO_SECRET_KEY
PAYMENT_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_SECRET
PAYMENT_SUCCESS_URL=https://your-domain.example/?payment=success
PAYMENT_CANCEL_URL=https://your-domain.example/?payment=cancelled
